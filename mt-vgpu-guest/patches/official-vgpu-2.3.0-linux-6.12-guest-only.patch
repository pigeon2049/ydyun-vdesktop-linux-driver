@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: GPL-2.0 OR MIT */
+#ifndef MTGPU_KERNEL_COMPAT_H
+#define MTGPU_KERNEL_COMPAT_H
+
+#include <linux/version.h>
+#include <linux/types.h>
+
+/* Linux 6.11 changed platform_driver.remove() from int to void. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 11, 0)
+#define MT_PLATFORM_REMOVE_TYPE void
+#define MT_PLATFORM_REMOVE_RETURN
+#else
+#define MT_PLATFORM_REMOVE_TYPE int
+#define MT_PLATFORM_REMOVE_RETURN return 0;
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0) && !defined(DRM_UNLOCKED)
+#define DRM_UNLOCKED 0
+#endif
+
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0)
+static inline size_t mtgpu_strlcpy_compat(char *dst, const char *src, size_t size)
+{
+	size_t i = 0, len = 0;
+
+	while (src[len])
+		len++;
+	if (size) {
+		while (i + 1 < size && src[i]) {
+			dst[i] = src[i];
+			i++;
+		}
+		dst[i] = '\0';
+	}
+	return len;
+}
+
+static inline size_t mtgpu_strlcat_compat(char *dst, const char *src, size_t size)
+{
+	size_t dlen = 0, slen = 0, i = 0;
+
+	while (dlen < size && dst[dlen])
+		dlen++;
+	while (src[slen])
+		slen++;
+	if (dlen < size) {
+		while (dlen + i + 1 < size && src[i]) {
+			dst[dlen + i] = src[i];
+			i++;
+		}
+		dst[dlen + i] = '\0';
+	}
+	return dlen + slen;
+}
+#define MTGPU_STRLCPY mtgpu_strlcpy_compat
+#define MTGPU_STRLCAT mtgpu_strlcat_compat
+#else
+#define MTGPU_STRLCPY strlcpy
+#define MTGPU_STRLCAT strlcat
+#endif
+
+/* Linux 6.12 changed tty_operations.write() argument and return types. */
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+#define MT_TTY_WRITE_RETURN ssize_t
+#define MT_TTY_WRITE_COUNT size_t
+#else
+#define MT_TTY_WRITE_RETURN int
+#define MT_TTY_WRITE_COUNT int
+#endif
+
+/* Linux 6.12 renamed the highest buddy order to MAX_PAGE_ORDER. */
+#ifndef MAX_ORDER
+#define MAX_ORDER (MAX_PAGE_ORDER + 1)
+#endif
+
+/* PCI_IRQ_LEGACY was renamed to PCI_IRQ_INTX. */
+#ifndef PCI_IRQ_LEGACY
+#define PCI_IRQ_LEGACY PCI_IRQ_INTX
+#endif
+
+#endif
